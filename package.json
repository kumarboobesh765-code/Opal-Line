{
  "name": "opal-line-project",
  "private": true,
  "version": "1.0.6",
  "main": "electron/dist/main.js",
  "description": "Opal Line Billing Software — Shopify-integrated billing with silver rate pricing",
  "author": "Opal Line Jewels LLP",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "overrides": {
    "qs": "^6.16.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:server": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "build:all": "npm run build -w frontend",
    "lint": "npm run lint -w frontend",
    "typecheck": "npm run typecheck -w backend",
    "test": "npm run test -w backend",
    "test:e2e": "playwright test",
    "db:push": "npm run db:push -w backend",
    "db:generate": "npm run db:generate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "start:server": "npm run start -w backend",
    "electron:dev": "npm run build -w frontend && npx tsx electron/main.ts",
    "electron:compile": "cd electron && npx tsc",
    "electron:build": "node scripts/build-desktop.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.4",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "asar": "^3.2.0"
  }
}
