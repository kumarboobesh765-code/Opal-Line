# Server
PORT=4000

# PostgreSQL — local install or Neon cloud
# Local: postgresql://postgres:REDACTED@localhost:5432/opal_line
# Neon:  postgresql://user:REDACTED@host.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:REDACTED@localhost:5432/opal_line

# Encryption key for storing secrets in the database (AES-256-GCM).
# Leave blank to auto-generate on first run (key saved to .encryption-key).
ENCRYPTION_KEY=

# Optional: Shopify credentials can also be set here as env vars.
# They will be overridden by values stored in the database (managed from the Settings UI).
# SHOPIFY_STORE_URL=your-store
# SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx
# SHOPIFY_API_VERSION=2025-10

# Order email ingestion — Shopify's owner "New Order" email contains full
# customer data even when API responses are redacted. Point a mailbox here,
# add it as a staff order-notification recipient in Shopify Admin →
# Settings → Notifications, and the ERP will poll it every 2 minutes.
# Gmail: enable 2FA + IMAP, then use an App Password.
# ORDER_EMAIL_ADDRESS=orders@yourdomain.com
# ORDER_EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx   (encrypt with encV1: prefix)
# ORDER_EMAIL_HOST=imap.gmail.com
# ORDER_EMAIL_PROVIDER=mailtm   (use mailtm for mail.tm REST mailboxes, imap otherwise)
# ORDER_EMAIL_PORT=993
# ORDER_EMAIL_FOLDER=INBOX
